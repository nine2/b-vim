" 快速补全, 需要 vim 支持 python
Plug 'SirVer/ultisnips'
" Tab 统一由下方 SmartTab 路由（snippet > YCM popup > 普通 Tab，Copilot 已禁用），此处不绑定避免冲突
let g:UltiSnipsExpandTrigger="<nop>"
let g:UltiSnipsJumpForwardTrigger="<c-j>"
let g:UltiSnipsJumpBackwardTrigger="<c-k>"
" 列出匹配的所有 snippets
let g:UltiSnipsListSnippets="<c-a>"
" let g:UltiSnipsSnippetDirectories=[$VIM_CONFIG_PATH.'/projects/snips/']
let g:UltiSnipsSnippetDirectories=['UltiSnips', expand("$VIM_CONFIG_PATH/projects/snips")]

" If you want :UltiSnipsEdit to split your window.
let g:UltiSnipsEditSplit="vertical"

" github 上的 snippets 集合
Plug 'bbxytl/vim-snippets'

Plug 'rizzatti/dash.vim'
map <leader>ds :Dash<cr>

" Ch.10 删除：vim-devicons 段（散兵，已归档）

Plug 'rhysd/github-complete.vim'
" Disable overwriting 'omnifunc'
let g:github_complete_enable_omni_completion = 0
" <C-x><C-x> invokes completions of github-complete.vim
" autocmd FileType markdown,gitcommit,mkd
imap <C-k><C-o> <Plug>(github-complete-manual-completion)


" xterm 颜色(256色)
Plug 'guns/xterm-color-table.vim'
" :XtermColorTable

" Copilot 已禁用（组织策略），旧配置保留在 git 历史里；改用自研 Gemini 补全替代，
" 设计文档见 b-vim/docs/superpowers/specs/2026-08-05-vim-gemini-completion-design.md
set rtp+=$VIM_CONFIG_PATH/gemini-complete
" gemini-complete 的 set rtp+= 发生在本文件（vimrc.bundles_complex 经由 vimrc.bundles_base
" 在 call plug#end() 之前 source），理论上 plug#end() 的运行时扫描会覆盖到它；显式 runtime!
" 一次是防御性写法，避免依赖 vim-plug 内部扫描时机的隐性假设（同一文件里 YCM/vim-go 那种
" plug#end() 之后才 rtp+= 的情形必须手动 runtime!，这里保留同样的显式声明更稳妥）
runtime! plugin/gemini_complete.vim

" Tab 路由：UltiSnips 展开 → YCM popup 导航 → Gemini 建议接受 > 普通 Tab
" 优先级：snippet > 补全菜单 > AI ghost text > 普通 Tab
function! s:SmartTab()
    call UltiSnips#ExpandSnippetOrJump()
    if g:ulti_expand_or_jump_res > 0
        return ""
    endif
    if pumvisible()
        return "\<C-n>"
    endif
    if gemini_complete#HasSuggestion()
        return gemini_complete#Accept()
    endif
    return "\<Tab>"
endfunction
imap <silent><expr> <Tab> <SID>SmartTab()

" 开关 Gemini 自动补全
nnoremap <Leader>cp :GeminiToggle<CR>


let g:cur_bundle_file_path = expand("$VIM_TMP_PATH/vimrc.bundles_completion")
if filereadable(expand(g:cur_bundle_file_path))
    exec "so  ".g:cur_bundle_file_path
else
    let g:cur_bundle_file_path = expand("$VIM_CONFIG_PATH/vimrc.bundles_ycm")
    " 默认加载ycm
    if filereadable(expand(g:cur_bundle_file_path))
        exec "so  ".g:cur_bundle_file_path
    endif
endif

