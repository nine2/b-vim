" 仍保留 set hidden（vim 多 buffer 不强制保存）
set hidden

Plug 'Valloric/ListToggle'
let g:lt_location_list_toggle_map = '<leader>lt'    " toggle location list（开/关）
let g:lt_quickfix_list_toggle_map = '<leader>qt'    " toggle quickfix（开/关）
" cq: 一键关闭所有辅助窗口（quickfix + location list + preview）
" 适用：在主代码 buffer 中按 :GoReferrers / :GoBuild 后弹出 quickfix，
" 想关掉时无需切到 quickfix 窗口再 :q —— 直接 cq 全部关掉
" 注：c 是 change operator，但 cq 不是有效 motion 组合，绑此键安全
nnoremap <silent> cq :cclose<bar>lclose<bar>pclose<CR>
