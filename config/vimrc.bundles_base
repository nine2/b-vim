" ################## 插件配置结束 ###########################
call plug#end()    " 内含 filetype plugin indent on

" === 软链特例（不纳入 vim-plug 管理，避免 :PlugClean 误删）===
" 这些通过软链指向具体版本目录，plug#end 之后手动 set rtp+= 加载
set rtp+=$VIM_TMP_PATH/bundle/YouCompleteMe
" vim-go 用 rtp^=（前插）而非 rtp+=：$VIMRUNTIME 早已在 rtp 中，
" 若用 rtp+= 追加到最后，:runtime! ftplugin/go.vim 会先命中 Vim 自带的
" 精简版 ftplugin/go.vim（它会 let b:did_ftplugin=1），导致 vim-go 自己
" 那份 ftplugin/go.vim 被同名 guard 挡住直接 finish——omnifunc、
" go_def_mapping_enabled 相关的 <C-]>/gd 映射等都不会被设置。
" 前插到 rtp 最前，让 vim-go 的 ftplugin 先跑、自己置位 guard，
" Vim 自带那份随后命中 guard 正常跳过，不受影响。
set rtp^=$VIM_TMP_PATH/bundle/vim-go
set rtp+=$VIM_TMP_PATH/bundle/ycm_simple_conf

" plug#end 已完成 plugin/ 扫描；上面 set rtp+= 后加入的目录需要手动 source 其 plugin/
" 否则 YouCompleteMe / vim-go 的 plugin/*.vim 不会被加载，命令未注册
runtime! plugin/youcompleteme.vim
runtime! plugin/go.vim

" YCM 默认通过 'autocmd VimEnter * call youcompleteme#Enable()' 启用，
" 但在 set rtp+= 后手动 runtime! 时机会让 VimEnter autocmd 注册时序错乱，
" 直接在 VimEnter 时手动调用 Enable()，确保命令注册（:YcmCompleter 等）
autocmd VimEnter * silent! call youcompleteme#Enable()

" === 依赖插件已加入 rtp 的命令（必须在 plug#end 之后立即执行）===
" 配色方案
silent! colorscheme molokai
" airline section（需要 vim-airline 加载完成）
if exists('*airline#section#create_right')
    let g:airline_section_z = airline#section#create_right(['%lL:%cC│ %p%%/%LL'])
endif
