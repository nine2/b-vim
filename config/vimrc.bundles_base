"
"  vim-plug 插件管理和配置项（2026-05-08 从 Vundle 迁移）
" -----------------#github
"   插件来自 github，只需要 ： 作者名/项目名
"  Plug 'tomasr/molokai'
"   插件来自 vim-scripts，直接写插件名就行了
"  Plug 'L9'
"   如使用自己的git库的插件，像下面这样做
"  Plug 'git://git.wincent.com/command-t.git'
" ---------------#git库在本地机器的情况
"   如使用自己的git库在本地机器，像下面这样做
"  Plug 'file:///Users/gmarik/path/to/plugin'
"
" ==========================================

set nocompatible               " be iMproved
filetype off " required! turn off
" === vim-plug 初始化 ===（替代原 vundle，详见 VIM_PLUG_MIGRATION_PLAN.md）
" 复用 bundle/ 目录路径，兼容现有软链 + 归档目录
" vim-plug 自身位于 $VIM_TMP_PATH/autoload/plug.vim，需把 $VIM_TMP_PATH 加入 rtp
set rtp+=$VIM_TMP_PATH
call plug#begin($VIM_TMP_PATH . '/bundle')

" ################### 插件禁用 guard（必须在 Bundle 加载前设）#########################
" TagHighlight 启动 ~104ms 且基本不用；git-messenger 默认 CursorHold 弹 blame
let g:loaded_TagHighlight = 1
let g:loaded_git_messenger = 1
" gitgutter 性能化配置（恢复跳变更行、行首 hunk 标记，关闭主动轮询）
" --------------------------------------------------------------
" 自定义快捷键见 filetype_bundles/git.vim:23-26
"   gt    toggle 显示 sign 列
"   gn    跳到【下一个】变更 hunk
"   gp    跳到【上一个】变更 hunk
"   gr    undo 当前 hunk（注意：跟 <leader>gr=LeaderF gtags 不冲突，前者两键后者三键）
" 默认快捷键（]c/[c/<leader>h*）已被 g:gitgutter_map_keys = 0 全部禁用
let g:gitgutter_async = 1                  " 异步 git diff，不阻塞 UI（默认）
let g:gitgutter_eager = 0                  " 不在 BufEnter/TabEnter/FocusGained 主动触发
let g:gitgutter_realtime = 0               " 不在 TextChanged 实时 diff（仅保存时更新）
let g:gitgutter_max_signs = 500            " 限制 sign 数量，超过则不显示标记
let g:gitgutter_show_msg_on_hunk_jumping = 0  " 跳转时不打印 hunk 信息

" ################### Plugins 配置 #########################
" 使用 vim-plug 管理插件（2026-05-08 从 Vundle 迁移）
"     :PlugInstall       安装新增插件
"     :PlugUpdate        更新所有插件
"     :PlugStatus        查看插件状态
"     :PlugClean         ⚠️ 不要使用（会误删 YCM/vim-go 软链）
" vundle 已归档至 .vim/bundle.archive/vundle/


" ###############################
" 主题 molokai
Plug 'nine2/molokai'
let g:molokai_original = 1
set t_Co=256
" colorscheme molokai 不在此处执行 —— 移至 plug#end() 之后立即设置
" 因为 vim-plug 仅在 plug#end() 时把插件加入 rtp，此时 molokai 还未可用

" ###############################
" 主题. 状态栏
" Bundle 'Lokaltog/vim-powerline'
Plug 'vim-airline/vim-airline'
" set statusline=%<%f\ %h%m%r%=%k[%{(&fenc==\"\")?&enc:&fenc}%{(&bomb?\",BOM\":\"\")}]\ %-14.(%l,%c%V%)\ %P
" Bundle 'gcmt/taboo.vim'
" let g:taboo_tab_format = " %N.[%f %m] "
" let g:taboo_modified_tab_flag = "+"
Plug 'vim-airline/vim-airline-themes'
let g:airline_theme='molokai'
" let g:airline_theme='powerlineish'
" let g:airline_theme='monochrome'
let g:airline_exclude_preview = 0
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#show_tabs = 1
let g:airline#extensions#tabline#show_tab_nr = 1
let g:airline#extensions#tabline#tab_nr_type = 1
let g:airline#extensions#tabline#show_tab_type = 1
let g:airline#extensions#tabline#show_buffers = 0
let g:airline#extensions#tabline#buffer_nr_show = 1
let g:airline#extensions#tabline#buffer_idx_mode = 1
let g:airline#extensions#tabline#switch_buffers_and_tabs = 1
let g:airline#extensions#tabline#formatter = 'unique_tail'
" let g:airline_statusline_ontop=1

if !exists('g:airline_symbols')
    let g:airline_symbols = {}
endif
" unicode symbols
let g:airline_symbols.crypt = '🔒'
let g:airline_symbols.linenr = '␊'
" let g:airline_symbols.maxlinenr = '☰'
let g:airline_symbols.maxlinenr = '│'
let g:airline_symbols.paste = 'ρ'
let g:airline_symbols.spell = 'Ꞩ'
" let g:airline_symbols.notexists = '∄'
let g:airline_symbols.notexists = ' '
let g:airline_symbols.whitespace = 'Ξ'
" let g:airline_left_sep = '▶'
let g:airline_left_sep = ''
let g:airline_left_alt_sep = ''
" let g:airline_right_sep = '◀'
let g:airline_right_sep = ''
let g:airline_right_alt_sep = ''
" let g:airline_symbols.branch = '⎇'
let g:airline_symbols.branch = ''
let g:airline_symbols.readonly = ''
let g:airline_powerline_fonts = 1
" 修改文件： ~/.vim/bundle/vim-airline/autoload/airline.vim 中的下面的函数
"     可以在状态栏显示时间
" function! airline#statusline(winnr)
"   if has_key(s:contexts, a:winnr)
"    " return '%{airline#check_mode('.a:winnr.')}'.s:contexts[a:winnr].line
"     return '%{airline#check_mode('.a:winnr.')}'.s:contexts[a:winnr].line.'|'.strftime("%d %H:%M")
"   endif
"  " in rare circumstances this happens...see #276
"   return ''
" endfunction

" 状态栏布局
"let g:airline#extensions#default#layout = [
"      \ [ 'a', 'b', 'c' ],
"      \ [ 'x', 'y', 'z', 'warning', 'error' ]
"      \ ]
" %B:ANSII码，%l:行号, %c:列号, %P:当前文件的百分比行, filetype:文件类型
" let g:airline_section_x = airline#section#create_right([' %B│ %lL:%cC│ %p%%│ ', 'filetype'])
" airline_section_z 不在此处执行 —— 移至 plug#end() 之后立即设置
" 因为 airline#section#create_right 需要 vim-airline 已加入 rtp

" let g:airline#extensions#taboo#enabled = 0
" let g:airline#extensions#bufferline#enabled = 1
" let g:airline#extensions#csv#enabled = 1
let g:airline#extensions#fugitiveline#enabled = 0  " 大 .git 仓库每次 redraw 同步调 git，关
let g:airline_highlighting_cache = 1               " 缓存高亮计算（airline 文档推荐）
let g:airline#extensions#hunks#enabled = 0  " 原为 1，每次 CursorHold 调 git diff 统计增删行，开销不小
let g:airline#extensions#coc#enabled = 1
" let g:airline#extensions#tmuxline#enabled = 1
let g:airline#extensions#whitespace#enabled = 0
let g:airline#extensions#wordcount#enabled = 0  " 原为 1，大文件每次 CursorHold 统计字数有额外开销
let b:airline_whitespace_checks = [ 'indent', 'trailing' ]
" let b:airline_whitespace_checks = [ 'trailing' ]
let g:airline#extensions#ycm#enabled = 1
" Always show the status line - use 2 lines for the status bar
set laststatus=2


" ###### 中文 vim 帮助
Plug 'asins/vimcdoc'


" ##### 自动根据当前打开文件切换工作目录
Plug 'nine2/vim-rooter'
let g:rooter_silent_chdir = 1
let g:rooter_resolve_links = 1
let g:rooter_manual_only = 1                " BufEnter 不再上溯查 .git，大仓库下显著降卡顿
nmap <leader>cd :AutoChangeDirectory <cr>


" ###############################
" 代码格式管理
" ##### 缩进标识, 这块通过设置 list 在文件 vimrc.config_base 里有些函数实现
Plug 'nine2/vim-indent-guides'
map <leader>i :Nine2IndentGuides<cr>

" ##### 快速去行尾空格
Plug 'bronson/vim-trailing-whitespace'
" 下列文件类型中的行尾空格tab不高亮显示
let g:extra_whitespace_ignored_filetypes = ['unite', 'mkd', 'diff', 'ctrlsf', 'git', 'qf']
map <leader>, :FixWhitespace<cr>


" ###### 快速注释
Plug 'scrooloose/nerdcommenter'
" <leader>cc 注释选中内容
" <leader>cu 取消选中注释
" <leader>c$ 从当前光标开始到行尾注释掉
let g:NERDCustomDelimiters = {
    \ 'c': { 'leftAlt': '/*','rightAlt': '*/', 'left': '//', 'right': '' },
    \ 'plantuml': { 'leftAlt': "/'",'rightAlt': "'/", 'left': "'", 'right': '' },
    \ }
let NERD_cpp_alt_style=1
let NERD_c_alt_style=1
let g:NERDSpaceDelims=1


" ###############################
" 语法高亮
" 针对项目设置的自定义语法，参考 README
Plug 'nine2/vim-custom-syntax'
" 可使用此配置关闭语法高亮
" let g:custom_syntax_hightlight_enable= 0
" 语法高亮
" let g:custom_syntax_hightlight_macro= 1
" Ch.3 删除：syntastic（已归档至 .vim/vimrc.archive/vimrc.bundles_base）

Plug 'w0rp/ale'
" let g:ale_enabled= 0
let g:ale_sign_error = '✘✘'
let g:ale_sign_warning = '➤➤'
highlight clear ALEErrorSign
highlight clear ALEWarningSign
" 使用 quickfix 替换 location 窗口
" let g:ale_set_quickfix = 1
" let g:ale_set_location = 1
let g:ale_list_window_size = 5
" --- ALE 触发时机：编辑时不 lint，仅在保存时跑（消除编辑卡顿）---
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_insert_leave = 0
let g:ale_lint_on_enter = 0
let g:ale_lint_on_save = 1
let g:ale_lint_on_filetype_changed = 0
" --- 异步 fix on save：替代 vim-go 同步的 BufWritePre gofmt/goimports（实测省 ~1.1s）---
let g:ale_fix_on_save = 1
let g:ale_fixers = {
      \ 'go':         ['goimports', 'gofmt'],
      \ 'python':     ['autopep8', 'isort'],
      \ '*':          ['remove_trailing_lines', 'trim_whitespace'],
      \ }
let g:ale_go_staticcheck_lint_package = 0   " 原为 1，lint 整包比单文件慢 5~20x
" let g:ale_go_gometalinter_lint_package = 0
let g:ale_echo_msg_error_str = 'E'
let g:ale_echo_msg_warning_str = 'W'
let g:ale_echo_msg_format = '[%linter%] %s [%severity%]'
" go 文件配置
let g:ale_go_golangci_lint_executable  = "golangci-lint"
let g:ale_go_golangci_lint_package = 0      " 原为 1，lint 整包比单文件慢 5~20x
" 需要安装 gopls 工具
" let g:ale_linters = {'go': ['go vet', 'gofmt', 'golint']}
" let g:ale_linters = {'go': ['gopls']}
" let g:ale_linters = {'go': ['gopls'], 'python':['pep8', 'pyflakes']}
" 需要安装 golangci-lint ，速度快，比 gopls 占用内存少,
" 静态检查足够了（检查的非常细）
" let g:ale_linters = {'go': ['golangci-lint'], 'python':['pep8', 'pyflakes']}
" 默认仅用 golangci-lint，避免 gopls/govet/staticcheck 多 linter 叠加
let g:ale_linters = {'go': ['golangci-lint']}
let g:ale_go_golangci_lint_options = '--fast'  " 大仓库下 fast 模式 vs 完整跑相差 5~10x
autocmd FileType python,py let g:ale_linters = {'python':['pep8', 'flake8']}
autocmd FileType python,py let g:ale_type_map = {
      \ 'pycodestyle' : {'ES' : 'WS', 'E': 'W'},
      \ 'flake8' : {'E': 'W'}
      \}
" autocmd FileType go let g:ale_linters = {'go': ['golangci-lint']}

let g:airline#extensions#ale#enabled = 1
let g:ale_lint_on_text_changed = 'never'    " 原为 1，每次按键都 lint 是最主要卡顿源
let g:ale_lint_on_insert_leave = 0          " 退出 insert 不触发，改由保存时统一执行
let g:ale_lint_on_save = 1
nmap <silent> ek <Plug>(ale_previous_wrap)
nmap <silent> ej <Plug>(ale_next_wrap)
nmap <silent> eh <Plug>(ale_first)
nmap <silent> el <Plug>(ale_last)

" 给 typedef 和 enum 配色
" 需要使用到 ctags
Plug 'vim-scripts/TagHighlight'

" ###############################
" 自动补全

" ###### 自动补全单引号，双引号等
Plug 'Raimondi/delimitMate'
" for python docstring ,优化输入
au FileType python let b:delimitMate_nesting_quotes = ['"']
au FileType markdown let b:delimitMate_nesting_quotes = ['`']

"Displays function signatures from completions in the command line.
"When you accept a completion for a function with <c-y>, echodoc will display
"the function signature in the command line and highlight the argument
"position your cursor
Plug 'Shougo/echodoc.vim'
" set cmdheight=3
let g:echodoc_enable_at_startup = 1


" ###############################
" Vim 快捷操作
" ##### 更高效的移动 [,, + w/fx]
Plug 'Lokaltog/vim-easymotion'
let g:EasyMotion_smartcase = 1
"let g:EasyMotion_startofline = 0 " keep cursor colum when JK motion
map fh <Plug>(easymotion-linebackward)
map fw <Plug>(easymotion-w)
map fj <Plug>(easymotion-e)
map fk <Plug>(easymotion-b)
map fl <Plug>(easymotion-lineforward)
" map fb <Plug>(easymotion-b)
" map fe <Plug>(easymotion-e)
" 重复上一次操作, 类似repeat插件, 很强大
map <Leader><leader>. <Plug>(easymotion-repeat)


" ##### 快速的匹配 https://github.com/vim-scripts/matchit.zip
" Bundle 'vim-scripts/matchit.zip'


" Ch.10 删除：vim-signature 段（散兵，整段已注释，已归档）


" 书签
" Usage : https://github.com/MattesGroeger/vim-bookmarks#usage
" After installation you can directly start using it. You can do this by either using the default shortcuts or the commands:
"
" Action	Shortcut	Command
" Add/remove bookmark at current line	mm	:BookmarkToggle
" Add/edit/remove annotation at current line	mi	:BookmarkAnnotate <TEXT>
" Jump to next bookmark in buffer	mn	:BookmarkNext
" Jump to previous bookmark in buffer	mp	:BookmarkPrev
" Show all bookmarks (toggle)	ma	:BookmarkShowAll
" Clear bookmarks in current buffer only	mc	:BookmarkClear
" Clear bookmarks in all buffers	mx	:BookmarkClearAll
" Move up bookmark at current line	[count]mkk	:BookmarkMoveUp [<COUNT>]
" Move down bookmark at current line	[count]mjj	:BookmarkMoveDown [<COUNT>]
" Move bookmark at current line to another line	[count]mg	:BookmarkMoveToLine <LINE>
" Save all bookmarks to a file		:BookmarkSave <FILE_PATH>
" Load bookmarks from a file		:BookmarkLoad <FILE_PATH>

Plug 'MattesGroeger/vim-bookmarks'
let g:bookmark_auto_save = 1
let g:bookmark_save_per_working_dir = 1
" You could unbind the keys whenever Nerdtree becomes active (thanks to @Nitive).
let g:bookmark_no_default_key_mappings = 1
function! BookmarkMapKeys()
    nmap mm :BookmarkToggle<CR>
    nmap mi :BookmarkAnnotate<CR>
    nmap mn :BookmarkNext<CR>
    nmap mp :BookmarkPrev<CR>
    nmap ma :BookmarkShowAll<CR>
    nmap mc :BookmarkClear<CR>
    nmap mx :BookmarkClearAll<CR>
    nmap mkk :BookmarkMoveUp
    nmap mjj :BookmarkMoveDown
endfunction
function! BookmarkUnmapKeys()
    unmap mm
    unmap mi
    unmap mn
    unmap mp
    unmap ma
    unmap mc
    unmap mx
    unmap mkk
    unmap mjj
endfunction
" 加 filetype 守卫，跳过辅助窗口，避免每次切换都重绑 9 个 nmap
autocmd BufEnter * if &filetype !~ '^\(nerdtree\|qf\|ale-preview\|tagbar\|help\)$' | call BookmarkMapKeys() | endif
autocmd BufEnter NERD_tree_* :call BookmarkUnmapKeys()

" ##### 选中区块
Plug 'terryma/vim-expand-region'
vmap v <Plug>(expand_region_expand)
vmap V <Plug>(expand_region_shrink)


" ##### 多光标选中编辑
Plug 'terryma/vim-multiple-cursors'
let g:multi_cursor_use_default_mapping=0
" Default mapping
let g:multi_cursor_next_key='<C-m>'
let g:multi_cursor_prev_key='<C-p>'
let g:multi_cursor_skip_key='<C-x>'

let g:multi_cursor_quit_key='<Esc>'

" ##### 文件搜索 LeaderF（Ch.5 替代 ctrlp.vim，Python + C 扩展，5-10x 快）
Plug 'Yggdroot/LeaderF'
" ============================================================
" 快捷键速查（按使用频率排序，全部进入浮窗后输入关键字过滤，<CR> 选中跳转）
"   <leader>f   按文件名【模糊搜索项目内所有文件】 → 类似 VSCode Cmd+P
"   <leader>b   按文件名【模糊搜索已打开的 buffer】（在多个文件间快速切换）
"   gl          跳到光标下符号的【定义】(gtags -d) — 跨语言主用（让出 gd 给 vim 内置）
"   gr          找光标下符号的所有【引用】(gtags -r)
"   gs          找符号的所有【出现位置】(gtags -s) — 含字符串/注释中的字面量
"   go          重新打开【上次搜索结果】(gtags --recall)
"   gd          vim 内置：跳本地声明 + 顺带高亮当前词（自定义映射已让出）
"   cq          一键关闭辅助窗口（quickfix + location list + preview）
" 命名空间冲突已迁移（让出短键给 LeaderF）：
"   gr 原 GitGutterUndoHunk → gz（git.vim，gz 在 vim 中无任何内置含义）
"   gs 原 :G status         → <leader>gst（git.vim）
" ============================================================
" 复用 ctrlp 时代的快捷键（保留 muscle memory）
let g:Lf_ShortcutF = '<leader>f'             " 模糊搜索项目文件（替代 :CtrlP）
let g:Lf_ShortcutB = '<leader>b'             " 模糊搜索已打开 buffer（替代 :CtrlPBuffer）
" 显示形态
let g:Lf_WindowPosition = 'popup'            " 浮窗
let g:Lf_PreviewInPopup = 1
let g:Lf_StlSeparator = { 'left': '', 'right': '' }
let g:Lf_UseVersionControlTool = 0           " 不强依赖 VCS
let g:Lf_DefaultExternalTool = 'rg'          " ripgrep 后端
" Gtags 跨语言代码索引（定义 / 引用 / 调用关系）
" ============================================================
" 系统依赖（必装，否则 :w 会报错且不工作）：
"   brew install global    # gtags 主体（GLOBAL 项目）
"   brew install pygments  # 启用 native-pygments 模式后扩展到 30+ 语言
" ============================================================
" 用法：
"   :Leaderf gtags --update    # 手动重建索引（首次进项目会自动建）
"   :Leaderf gtags -d <符号>   # 跳到定义
"   :Leaderf gtags -r <符号>   # 找所有引用
"   :Leaderf gtags -s <符号>   # 找所有出现位置
"   :Leaderf gtags --recall    # 重新打开上次搜索结果
" 索引文件：默认存于 ~/.LfCache/，不污染项目目录
" ============================================================
let g:Lf_GtagsAutoGenerate = 1               " 进入项目自动生成 GTAGS
let g:Lf_GtagsAutoUpdate = 1                 " 保存时自动增量更新
let g:Lf_Gtagslabel = 'native-pygments'      " native(C/C++/Java/PHP) + pygments(其他)
let g:Lf_GtagsStoreInProject = 0             " 索引存 ~/.LfCache/，不污染项目
" 跳转快捷键 — --auto-jump=1：仅当结果只有 1 个时自动跳转，不再弹浮窗
" gl: 跳到光标下符号的【定义】(gtags -d)
" gd 让回 vim 内置（跳本地声明 + 顺带把 cword 写入 / 寄存器实现全文高亮）
nnoremap gl :<C-U>Leaderf gtags --auto-jump=1 -d <C-R><C-W><CR>
" gr: 找光标下符号的所有【引用】（哪些地方调用了它）
nnoremap gr :<C-U>Leaderf gtags --auto-jump=1 -r <C-R><C-W><CR>
" gs: 找符号的所有【出现位置】（包括字符串字面量、注释中的同名出现）
nnoremap gs :<C-U>Leaderf gtags --auto-jump=1 -s <C-R><C-W><CR>
" go: 重新打开【上次的搜索结果】，无需重跑
nnoremap go :<C-U>Leaderf gtags --recall<CR>
" 文件忽略（迁移自 ctrlp_custom_ignore）
set wildignore+=*/.git/*,*/.hg/*,*/.svn/*
let g:Lf_WildIgnore = {
    \ 'dir':  ['.git', '.hg', '.svn', '.rvm'],
    \ 'file': ['*.exe', '*.so', '*.dll', '*.zip', '*.tar', '*.tar.gz', '*.pyc', '*.a', 'tags'],
    \ }
let g:Lf_FollowLinks = 1                     " 等价 ctrlp_follow_symlinks=1
let g:Lf_MruMaxFiles = 500                   " 等价 ctrlp_mruf_max=500
" 进阶：函数 / 行 / rg 搜索（按需打开）
" nnoremap <leader>j :LeaderfFunction<CR>
" nnoremap <leader>L :LeaderfLine<CR>
" nnoremap <leader>r :Leaderf rg<CR>

" ##### 类似sublimetext的搜索
Plug 'dyng/ctrlsf.vim'
""""""
" In CtrlSF window:
" 回车/o, 打开
" t       在tab中打开(建议)
" T - Lkie t but focus CtrlSF window instead of opened new tab.
" q - Quit CtrlSF window.
" let g:ctrlsf_position = 'right'
let g:ctrlsf_position = 'bottom'
let g:ctrlsf_winsize = '22'
let g:ctrlsf_auto_close = 0
let g:ctrlsf_use_location_list = 0  " 使用 quickfix 而不是 location list
let g:ctrlsf_search_mode = 'async'
let g:ctrlsf_confirm_save = 0
let g:ctrlsf_indent = 2
let g:ctrlsf_auto_preview = 0
let g:ctrlsf_regex_pattern = 1
let g:ctrlsf_selected_line_hl = ''
" let g:ctrlsf_selected_line_hl = 'op'
" Defines whether CtrlSF will feed quickfix and location list with search result.
" let g:ctrlsf_ignore_dir = ['bower_components', 'npm_modules']
" ignore file
" https://github.com/ggreer/the_silver_searcher/wiki/Advanced-Usage
" By default, Ag will read the patterns in .gitignore and .hgignore files in directories it searches.
" You can also create .ignore files to ignore things that are in your source repository. .ignore uses the same patterns as .gitignore and .hgignore.
"
" Note: cannot use <CR> or <C-m> for open
" Use : <sapce> or <tab>
let g:ctrlsf_mapping = {
    \ "open"  : ["<Space>o", "<CR>", "<LeftMouse>"],
    \ "openb" : "O",
    \ "tab"   : ["t", "<2-LeftMouse>"],
    \ "tabb"  : "T",
    \ "prevw" : "p",
    \ "quit"  : "q",
    \ "next"  : "<C-J>",
    \ "prev"  : "<C-K>",
    \ "pquit" : "q",
    \ }

let g:ctrlsf_extra_backend_args = {
    \ 'pt': '--home-ptignore',
    \ 'ag': '--path-to-ignore ~/.ag_ignore'
    \ }

    let g:ctrlsf_auto_focus = {
        \ "at" : "done",
        \ "duration_less_than": 1000
        \ }

" 切换显示模式
let g:ctrlsf_default_view_mode = 'compact'
fun! CtrlsfViewMode()
    if g:ctrlsf_default_view_mode == 'normal'
        let g:ctrlsf_default_view_mode = 'compact'
        let g:ctrlsf_populate_qflist = 1
    else
        let g:ctrlsf_default_view_mode = 'normal'
        let g:ctrlsf_populate_qflist = 0
    endif
endfun

map <leader>\ :call CtrlsfViewMode()<cr>
nmap \ <Plug>CtrlSFCwordPath<CR>

" 使用 normal 方式搜索
nmap \\ :let g:ctrlsf_default_view_mode_last = g:ctrlsf_default_view_mode<CR> :let g:ctrlsf_default_view_mode='normal'<CR> <Plug>CtrlSFCwordPath<CR> :let g:ctrlsf_default_view_mode = g:ctrlsf_default_view_mode_last<CR>

nmap <F7> :CtrlSF -R '\W<c-r>=expand("<cword>")<cr>[(,)]'<cr>
nmap sf   :CtrlSF -R '\W<c-r>=expand("<cword>")<cr>[(,)]'<cr>
nnoremap sp :CtrlSF<CR>
nmap <leader>aa :CtrlSF -R '\W<c-r>=expand("<cword>")<cr>'<cr>

Plug 'rking/ag.vim'
let g:ag_prg="ag --vimgrep --smart-case  --column --nogroup --noheading"
let g:ag_working_path_mode="r"
let g:ag_highlight=1
" nmap <F7> :Ag -w <c-r>=expand("<cword>")<cr><cr>
" 查找函数调用
nmap ag :Ag -w <c-r>=expand("<cword>")<cr> \| grep '<c-r>=expand("<cword>")<cr>('<cr>
" 查询当前单词, 立刻查询
nmap <leader>ag :Ag -w <c-r>=expand("<cword>")<cr><cr>
" Ag 默认查找当前单词，可修改, 不立刻查询
" nmap <leader>a :Ag <c-r>=expand("<cword>")<cr>
nmap <leader>a :Ag '


